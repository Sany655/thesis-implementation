# Base URL for the FastAPI backend service
# Local development:
VITE_API_URL=http://localhost:8000

# Production (Vercel Unified Monorepo / Single Domain):
# Leave blank to use relative paths (/predict, /assessments, /health)
# VITE_API_URL=

# Production (Decoupled backend on Render, Railway, Fly.io, HuggingFace):
# VITE_API_URL=https://your-fastapi-backend.onrender.com
